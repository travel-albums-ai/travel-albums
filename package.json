{
  "name": "travel-albums",
  "private": true,
  "version": "1.59.0",
  "type": "module",
  "scripts": {
    "#-----RUNNING------": "",
    "dev": "concurrently --names \"💻 ,🗃️  \" --prefix-colors \"cyan,yellow\" \"npm:dev:client\" \"npm:server\"",
    "dev:client": "vite",
    "server": "node server.mjs",
    "#-----BUILDING------": "",
    "build": "vite build",
    "bundle": "npm run bundle:server && npm run bundle:indexer",
    "bundle:server": "esbuild server.mjs --bundle --platform=node --target=node18 --outfile=./server.bundle.cjs --external:sharp --minify",
    "bundle:indexer": "esbuild ./scripts/indexer.mjs --bundle --platform=node --target=node18 --outfile=./indexer.bundle.cjs --minify",
    "copy:server": "cp server.bundle.cjs ../trip-gallery-builder/others",
    "copy:dist": "cp -r ./dist/* ../trip-gallery-builder/resources/",
    "copy:indexer": "cp indexer.bundle.cjs ../trip-gallery-builder/others",
    "prepare:build": "npm run build && npm run copy:dist",
    "prepare:bundles": "npm run bundle:server && npm run copy:server && npm run bundle:indexer && npm run copy:indexer",
    "#-----TOOLS------": "",
    "indexer:hdd": "node scripts/indexer.mjs --config server-config.json",
    "#-----UTILS------": "",
    "analyze": "VITE_BUNDLE_VISUALIZE=true vite build",
    "lint": "eslint .",
    "knip": "knip",
    "next": "semantic-release",
    "bun:arm64": "bun build server.mjs   --compile   --target=bun-windows-arm64   --outfile=TravelAlbums-arm64.exe",
    "bun:win32": "bun build server.mjs   --compile   --target=bun-windows-x64   --outfile=TravelAlbums-win32.exe",
    "bun:package": "npm run bun:arm64 && npm run bun:win32",
    "package": "npm run prepare:build && npm run prepare:bundles",
    "preview": "npm run build && concurrently --names \"💻 ,🗃️  \" --prefix-colors \"cyan,yellow\" \"npm run preview\" \"npm run server\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.2.0",
    "@mui/x-date-pickers": "^9.10.1",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.101.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bun": "^1.3.14",
    "compression": "^1.8.1",
    "dayjs": "^1.11.21",
    "driver.js": "^1.8.0",
    "exifr": "^7.1.3",
    "express": "^5.2.1",
    "flexlayout-react": "^0.10.2",
    "i18next": "^26.3.6",
    "leaflet": "^1.9.4",
    "localforage": "^1.10.0",
    "lucide-react": "^1.28.0",
    "p-limit": "^7.3.1",
    "react": "^19.2.8",
    "react-compare-slider": "^4.0.0",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-intersection-observer": "^11.0.0",
    "react-router-dom": "^7.18.2",
    "react-virtuoso": "^4.18.11",
    "react-zoom-pan-pinch": "^4.0.4",
    "sharp": "^0.35.3",
    "string-to-color": "^2.2.2",
    "uplot": "^1.6.32",
    "usewebmcp": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "knip": "^6.30.0",
    "rollup-plugin-visualizer": "latest",
    "semantic-release": "^24.2.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0"
  }
}
