{
  "$schema": "https://unpkg.com/knip/schema.json",

  "entry": [
  ],

  "project": [
    "src/**/*.{ts,tsx}",
    "server-utils/**/*",
    "scripts/**/*",
    "server.mjs"
  ],

  "ignore": [
    "src/**/*.d.ts"
  ],

  "ignoreDependencies": [
    "@types/*"
  ],

  "ignoreBinaries": [],

  "ignoreExportsUsedInFile": true,

  "typescript": {
    "config": "tsconfig.json"
  }
}
